# --- Base de datos principal ---
# Ruta del archivo SQLite de la DB principal (por defecto data/mylab.db)
PRIMARY_DB_PATH=data/mylab.db

# --- Sistema de respaldo (backup) ---
# Habilita/deshabilita todo el sistema de respaldo
BACKUP_ENABLED=true
# Ruta de la DB de respaldo (aislada, la app no la consulta en operación normal)
BACKUP_DB_PATH=data/mylab.backup.db
# Archivo de log del sistema de respaldo
BACKUP_LOG_PATH=data/backup/backup.log
# Reconciliación completa periódica (ms). 0 = deshabilitada
BACKUP_SYNC_INTERVAL_MS=30000
# Reintentos por cada operación de replicación
BACKUP_SYNC_RETRIES=3
# Intervalo del health check de la DB principal (ms)
BACKUP_HEALTH_CHECK_INTERVAL_MS=10000
# Timeout de cada ping al health check (ms)
BACKUP_HEALTH_TIMEOUT_MS=3000
# Fallos consecutivos necesarios para declarar la DB principal caída
BACKUP_HEALTH_FAILURE_THRESHOLD=2
# Tiempo de espera antes de restaurar (ms). Por defecto 5 minutos
BACKUP_RESTORE_WAIT_MS=300000

# --- API Gemini (opcional) ---
GEMINI_API_KEY=
